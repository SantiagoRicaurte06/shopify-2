{% doc %}
  Marks a testimonial as fictional.

  Demo content ships with the theme so the landing looks complete before the
  merchant has real reviews. It must never be mistaken for a real customer
  voice, so it carries a visible label and is excluded from structured data.

  @example
  {% render 'demo-badge' %}
{% enddoc %}

<p class="demo-badge">
  {% render 'icon', name: 'close' %}
  {{ 'landing.demo_badge' | t }}
</p>

{% stylesheet %}
  /* Visible without shouting: a quiet outline rather than a dashed red
     warning, so it reads as a factual label, not an alarm. */
  .demo-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-xs);
    padding: 0.2em 0.65em;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-pill);
    background-color: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .demo-badge .icon {
    width: 0.85em;
    height: 0.85em;
  }
{% endstylesheet %}
