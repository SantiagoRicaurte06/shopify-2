{% doc %}
  Marks a testimonial as fictional.

  Demo content ships with the theme so the landing looks complete before the
  merchant has real reviews. It must never be mistaken for a real customer
  voice, so it carries a visible label and is excluded from structured data.

  @example
  {% render 'demo-badge' %}
{% enddoc %}

<p class="demo-badge">
  {% render 'icon', name: 'close' %}
  {{ 'landing.demo_badge' | t }}
</p>

{% stylesheet %}
  .demo-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-xs);
    padding: 0.15em 0.6em;
    border: 1px dashed var(--color-sale);
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-sale);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
{% endstylesheet %}
