{% doc %}
  Renders a link or a submit button with the theme's button styling.

  @param {string} [label] - Visible text
  @param {string} [url] - Destination. Renders an <a> when present, a <button> otherwise
  @param {string} [style] - "primary" (default), "secondary" or "text"
  @param {string} [size] - "large" for the main calls to action
  @param {boolean} [full_width] - Stretches the button to its container
  @param {string} [type] - Button type when no url is given. Defaults to submit
  @param {string} [id] - DOM id, used by the sticky bar to watch the main button
  @param {boolean} [disabled] - Renders the button as unavailable

  @example
  {% render 'button', label: 'Agregar al carrito', size: 'large', full_width: true %}
{% enddoc %}

{%- liquid
  assign classes = 'button'
  assign variant = style | default: 'primary'
  assign classes = classes | append: ' button--' | append: variant

  if size == 'large'
    assign classes = classes | append: ' button--large'
  endif

  if full_width
    assign classes = classes | append: ' button--full'
  endif
-%}

{%- if url != blank -%}
  <a
    class="{{ classes }}"
    href="{{ url }}"
    {% if id %}
      id="{{ id }}"
    {% endif %}
  >
    {{- label -}}
  </a>
{%- else -%}
  <button
    class="{{ classes }}"
    type="{{ type | default: 'submit' }}"
    {% if id %}
      id="{{ id }}"
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
  >
    {{- label -}}
  </button>
{%- endif -%}

{% stylesheet %}
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-inputs);
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .button[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
    box-shadow: none;
  }

  .button--primary {
    background-color: var(--color-cta-background);
    color: var(--color-cta-foreground);
    box-shadow: var(--shadow-sm);
  }

  .button--primary:hover:not([disabled]) {
    box-shadow: var(--shadow-md);
  }

  .button--secondary {
    background-color: transparent;
    border-color: var(--color-border);
    color: var(--color-foreground);
  }

  .button--secondary:hover:not([disabled]) {
    border-color: var(--color-foreground);
    background-color: var(--color-surface);
  }

  .button--text {
    background-color: transparent;
    padding-inline: 0;
    min-height: 0;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .button--text:hover:not([disabled]) {
    text-decoration-thickness: 2px;
  }

  .button--large {
    padding: var(--space-md) var(--space-xl);
    font-size: var(--font-size-lg);
    min-height: 3.25rem;
  }

  .button--full {
    display: flex;
    width: 100%;
  }

  .button .icon {
    width: 1.15em;
    height: 1.15em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        transform var(--transition-fast),
        box-shadow var(--transition-fast),
        background-color var(--transition-fast),
        border-color var(--transition-fast);
    }

    .button:hover:not([disabled]) {
      transform: translateY(-1px);
    }

    .button:active:not([disabled]) {
      transform: translateY(0);
    }
  }
{% endstylesheet %}
