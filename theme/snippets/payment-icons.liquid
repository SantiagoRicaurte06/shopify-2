{% doc %}
  Lists the payment methods the merchant has actually enabled.

  These are rendered as labelled pills rather than brand marks: the logos of
  Visa, PSE, Nequi and the rest are trademarks that this theme has no licence
  to redistribute. If you want the real marks, add the files the provider gives
  you and swap the labels for images.

  The list is driven entirely by theme settings, so it can never advertise a
  method the store does not accept.

  @example
  {% render 'payment-icons' %}
{% enddoc %}

{%- if settings.show_payment_icons -%}
  {%- liquid
    assign methods = ''
    if settings.payment_card
      assign methods = methods | append: 'landing.payment.card,'
    endif
    if settings.payment_pse
      assign methods = methods | append: 'landing.payment.pse,'
    endif
    if settings.payment_nequi
      assign methods = methods | append: 'landing.payment.nequi,'
    endif
    if settings.payment_daviplata
      assign methods = methods | append: 'landing.payment.daviplata,'
    endif
    if settings.payment_bancolombia
      assign methods = methods | append: 'landing.payment.bancolombia,'
    endif
    if settings.payment_cash
      assign methods = methods | append: 'landing.payment.cash,'
    endif
    if settings.payment_bnpl
      assign methods = methods | append: 'landing.payment.bnpl,'
    endif
    assign method_list = methods | split: ','
  -%}

  {%- if method_list.size > 0 -%}
    <div class="payment-icons">
      {% render 'icon', name: 'lock', class: 'payment-icons__lock' %}
      <ul class="payment-icons__list">
        {%- for method in method_list -%}
          <li class="payment-icons__item">{{ method | t }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* One lock stands for the whole row rather than one per pill — repeating it
     reads as noise, not as reassurance. */
  .payment-icons {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-muted);
  }

  .payment-icons__lock {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  .payment-icons__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payment-icons__item {
    padding: 0.2em 0.65em;
    border-radius: var(--style-border-radius-pill);
    background-color: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
  }
{% endstylesheet %}
