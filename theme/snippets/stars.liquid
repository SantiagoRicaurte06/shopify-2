{% doc %}
  Renders a star rating.

  Two callers, one implementation:

  - Pass a `product` and the rating is read from the standard `reviews.rating`
    and `reviews.rating_count` metafields, which a reviews app maintains. If
    the product carries neither, this renders nothing at all. An empty rating
    is worse than no rating, and inventing one is not an option.

  - Pass an explicit `rating` and that value is drawn. This is how a
    theme-authored testimonial shows its stars, and it never claims to be an
    aggregate of anything.

  @param {product} [product] - Read the rating from this product's metafields
  @param {number} [rating] - An explicit rating, overriding the product
  @param {number} [rating_max] - Scale maximum for an explicit rating. Defaults to 5
  @param {boolean} [show_count] - Appends the number of reviews. Product ratings only

  @example
  {% render 'stars', product: product, show_count: true %}
  {% render 'stars', rating: block.settings.rating %}
{% enddoc %}

{%- liquid
  assign value = 0
  assign scale_max = 5
  assign count = 0

  if rating != blank
    assign value = rating
    assign scale_max = rating_max | default: 5
  else
    assign meta = product.metafields.reviews.rating.value
    assign count = product.metafields.reviews.rating_count.value | plus: 0

    if meta != blank and meta.rating != blank and count > 0
      assign value = meta.rating
      assign scale_max = meta.scale_max | default: 5
    endif
  endif
-%}

{%- if value > 0 -%}
  {%- liquid
    assign percent = value | times: 100.0 | divided_by: scale_max
  -%}
  <div class="stars">
    <span
      class="stars__track"
      role="img"
      aria-label="{{ 'landing.rating_aria' | t: rating: value, max: scale_max }}"
    >
      <span class="stars__fill" style="--rating-percent: {{ percent }}%"></span>
    </span>

    {%- if show_count and count > 0 -%}
      <span class="stars__count muted">
        {{- 'landing.rating_count' | t: count: count -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .stars {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* One character per star, filled by a clipped overlay, so a 4.3 reads as 4.3. */
  .stars__track {
    position: relative;
    display: inline-block;
    color: var(--color-border);
    font-size: var(--font-size-lg);
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .stars__track::before {
    content: '★★★★★';
  }

  .stars__fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--rating-percent);
    overflow: hidden;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .stars__fill::before {
    content: '★★★★★';
  }

  .stars__count {
    font-size: var(--font-size-sm);
  }
{% endstylesheet %}
