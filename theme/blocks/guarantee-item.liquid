{% doc %}
  One guarantee or policy promise.

  @example
  {% content_for 'block', type: 'guarantee-item', id: 'guarantee' %}
{% enddoc %}

<div class="guarantee-item card reveal" {{ block.shopify_attributes }}>
  <span class="icon-tile icon-tile--round icon-tile--lg">
    {% render 'icon', name: block.settings.icon %}
  </span>

  {%- if block.settings.heading != blank -%}
    <h3 class="guarantee-item__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}

  {%- if block.settings.body != blank -%}
    <div class="muted">{{ block.settings.body }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .guarantee-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.guarantee_item",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "default": "shield",
      "options": [
        { "value": "shield", "label": "t:options.icon.shield" },
        { "value": "refresh", "label": "t:options.icon.refresh" },
        { "value": "lock", "label": "t:options.icon.lock" },
        { "value": "clock", "label": "t:options.icon.clock" },
        { "value": "chat", "label": "t:options.icon.chat" },
        { "value": "check", "label": "t:options.icon.check" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Garantía"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    }
  ],
  "presets": [{ "name": "t:blocks.guarantee_item" }]
}
{% endschema %}
