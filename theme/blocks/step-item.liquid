{% doc %}
  One numbered step in the "how it works" sequence.

  The number comes from a CSS counter rather than a setting, so reordering the
  steps in the theme editor renumbers them and the merchant can never leave a
  step called "3" sitting in second place.

  @example
  {% content_for 'block', type: 'step-item', id: 'step' %}
{% enddoc %}

<li class="step-item reveal" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <div class="media-frame media-frame--landscape step-item__media">
      {% render 'responsive-image',
        image: block.settings.image,
        sizes: '(min-width: 750px) 30vw, 80vw',
        width: 700
      %}
    </div>
  {%- endif -%}

  {%- if block.settings.heading != blank -%}
    <h3 class="step-item__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}

  {%- if block.settings.body != blank -%}
    <div class="muted">{{ block.settings.body }}</div>
  {%- endif -%}
</li>

{% stylesheet %}
  .step-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    counter-increment: step;
  }

  /* An elegant circular counter, sized to match .icon-tile so a step and a
     benefit read as the same family of shape. */
  .step-item::before {
    content: counter(step);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--color-cta-background);
    color: var(--color-cta-foreground);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }

  .step-item__media {
    margin-block-end: var(--space-2xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.step_item",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Paso"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ],
  "presets": [{ "name": "t:blocks.step_item" }]
}
{% endschema %}
