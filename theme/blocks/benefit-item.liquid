{% doc %}
  One benefit: an icon or image, a heading and a short body.

  Used by the benefits section, and reusable anywhere a short value
  proposition belongs.

  @example
  {% content_for 'block', type: 'benefit-item', id: 'benefit' %}
{% enddoc %}

<div class="benefit-item reveal" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <div class="media-frame media-frame--landscape benefit-item__media">
      {% render 'responsive-image',
        image: block.settings.image,
        sizes: '(min-width: 750px) 25vw, 80vw',
        width: 600
      %}
    </div>
  {%- elsif block.settings.icon != 'none' -%}
    <span class="icon-tile">
      {% render 'icon', name: block.settings.icon %}
    </span>
  {%- endif -%}

  {%- if block.settings.heading != blank -%}
    <h3 class="benefit-item__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}

  {%- if block.settings.body != blank -%}
    <div class="benefit-item__body prose muted">{{ block.settings.body }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .benefit-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .benefit-item__media {
    margin-block-end: var(--space-2xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.benefit_item",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "default": "check",
      "options": [
        { "value": "none", "label": "t:options.icon.none" },
        { "value": "check", "label": "t:options.icon.check" },
        { "value": "truck", "label": "t:options.icon.truck" },
        { "value": "shield", "label": "t:options.icon.shield" },
        { "value": "lock", "label": "t:options.icon.lock" },
        { "value": "clock", "label": "t:options.icon.clock" },
        { "value": "refresh", "label": "t:options.icon.refresh" },
        { "value": "chat", "label": "t:options.icon.chat" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.block_image_overrides_icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Beneficio"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    }
  ],
  "presets": [{ "name": "t:blocks.benefit_item" }]
}
{% endschema %}
