{% doc %}
  One customer review, written by hand in the theme editor.

  Reviews configured here are theme content, not verified purchases. If the
  entry is marked as a demo it renders a visible notice saying so, and the
  structured-data snippet never sees it — rich results are built only from the
  standard `reviews.rating` metafields a reviews app maintains.

  Leaving `is_demo` on by default is deliberate. Placeholder copy that ships
  looking like a real testimonial is the failure mode worth preventing.

  The card itself is a snippet shared with the metaobject path in the reviews
  section, so both sources render identically.

  @example
  {% content_for 'block', type: 'review-item', id: 'review' %}
{% enddoc %}

<div class="review-item" {{ block.shopify_attributes }}>
  {% render 'review-card',
    body: block.settings.body,
    rating: block.settings.rating,
    author: block.settings.author,
    location: block.settings.location,
    image: block.settings.image,
    is_demo: block.settings.is_demo
  %}
</div>

{% stylesheet %}
  .review-item {
    display: flex;
    height: 100%;
  }

  .review-item > * {
    flex: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.review_item",
  "settings": [
    {
      "type": "checkbox",
      "id": "is_demo",
      "label": "t:labels.is_demo",
      "info": "t:info.is_demo",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:labels.rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:labels.author"
    },
    {
      "type": "text",
      "id": "location",
      "label": "t:labels.location"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ],
  "presets": [{ "name": "t:blocks.review_item" }]
}
{% endschema %}
