{% doc %}
  One customer review, written by hand in the theme editor.

  Reviews configured here are theme content, not verified purchases. If the
  entry is marked as a demo it renders a visible notice saying so, and the
  structured-data snippet never sees it — rich results are built only from the
  standard `reviews.rating` metafields a reviews app maintains.

  Leaving `is_demo` on by default is deliberate. Placeholder copy that ships
  looking like a real testimonial is the failure mode worth preventing.

  @example
  {% content_for 'block', type: 'review-item', id: 'review' %}
{% enddoc %}

<article class="review-item card reveal" {{ block.shopify_attributes }}>
  {%- if block.settings.is_demo -%}
    {% render 'demo-badge' %}
  {%- endif -%}

  {% render 'stars', rating: block.settings.rating %}

  {%- if block.settings.body != blank -%}
    <blockquote class="review-item__body">{{ block.settings.body }}</blockquote>
  {%- endif -%}

  <footer class="review-item__meta">
    {%- if block.settings.image != blank -%}
      {% render 'responsive-image',
        image: block.settings.image,
        sizes: '48px',
        width: 96,
        height: 96,
        crop: 'center',
        class: 'review-item__avatar'
      %}
    {%- endif -%}

    <div>
      {%- if block.settings.author != blank -%}
        <p class="review-item__author">{{ block.settings.author }}</p>
      {%- endif -%}
      {%- if block.settings.location != blank -%}
        <p class="muted review-item__location">{{ block.settings.location }}</p>
      {%- endif -%}
    </div>
  </footer>
</article>

{% stylesheet %}
  .review-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background-color: var(--color-background);
  }

  .review-item__body {
    margin: 0;
    font-style: italic;
  }

  .review-item__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: auto;
  }

  .review-item__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .review-item__author {
    font-weight: 700;
  }

  .review-item__location {
    font-size: var(--font-size-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.review_item",
  "settings": [
    {
      "type": "checkbox",
      "id": "is_demo",
      "label": "t:labels.is_demo",
      "info": "t:info.is_demo",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:labels.rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:labels.author"
    },
    {
      "type": "text",
      "id": "location",
      "label": "t:labels.location"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ],
  "presets": [{ "name": "t:blocks.review_item" }]
}
{% endschema %}
