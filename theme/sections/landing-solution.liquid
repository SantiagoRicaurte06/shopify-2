{% comment %}
  The answer to the problem: media on one side, copy on the other.

  The side the media sits on is a setting, so the same section can alternate
  down the page without a second file. On a phone the media always comes
  first, because the image is what earns the next scroll.
{% endcomment %}

<landing-reveal class="landing-solution landing-split{% if section.settings.media_position == 'right' %} landing-split--media-right{% endif %}{% if section.settings.background != 'none' %} bg-{{ section.settings.background }}{% endif %}">
  <div class="landing-solution__media">
    {% content_for 'blocks' %}
  </div>

  <div class="landing-solution__content reveal">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading
    %}

    {%- if section.settings.body != blank -%}
      <div class="landing-solution__body prose">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      {% render 'button',
        label: section.settings.cta_label,
        url: section.settings.cta_url,
        size: 'large'
      %}
    {%- endif -%}
  </div>
</landing-reveal>

{% stylesheet %}
  /* The grid itself is .landing-split in critical.css, shared with the problem
     section. Only what is specific to this section lives here. */
  .landing-solution__media .media-item img,
  .landing-solution__media .media-item video {
    border-radius: var(--style-border-radius-cards);
  }

  .landing-solution__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    max-width: 46ch;
  }

  .landing-solution__content .section-header {
    margin-block-end: 0;
  }

  .landing-solution__body {
    color: var(--color-muted);
    font-size: var(--font-size-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.solution",
  "tag": "section",
  "blocks": [{ "type": "media-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "t:labels.media_position",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "La forma sencilla de resolverlo"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "info": "t:info.section_background",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background.none" },
        { "value": "soft", "label": "t:options.background.soft" },
        { "value": "dark", "label": "t:options.background.dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.solution",
      "blocks": [{ "type": "media-item" }]
    }
  ]
}
{% endschema %}
