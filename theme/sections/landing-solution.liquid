{% comment %}
  The answer to the problem: media on one side, copy on the other.

  The side the media sits on is a setting, so the same section can alternate
  down the page without a second file. On a phone the media always comes
  first, because the image is what earns the next scroll.
{% endcomment %}

<landing-reveal class="landing-solution landing-solution--{{ section.settings.media_position }}">
  <div class="landing-solution__media">
    {% content_for 'blocks' %}
  </div>

  <div class="landing-solution__content reveal">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading
    %}

    {%- if section.settings.body != blank -%}
      <div class="landing-solution__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      {% render 'button',
        label: section.settings.cta_label,
        url: section.settings.cta_url,
        size: 'large'
      %}
    {%- endif -%}
  </div>
</landing-reveal>

{% stylesheet %}
  .landing-solution {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .landing-solution {
      grid-template-columns: 1fr 1fr;
    }

    /* Only the desktop layout flips. On a phone the media stays on top. */
    .landing-solution--right .landing-solution__media {
      order: 2;
    }
  }

  .landing-solution__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .landing-solution__content .section-header {
    margin-block-end: 0;
  }

  .landing-solution__body > * + * {
    margin-block-start: var(--space-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.solution",
  "tag": "section",
  "blocks": [{ "type": "media-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "t:labels.media_position",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "La forma sencilla de resolverlo"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.solution",
      "blocks": [{ "type": "media-item" }]
    }
  ]
}
{% endschema %}
