{% comment %}
  A grid pulled from one real collection.

  Every price, image and availability flag comes straight from the product —
  nothing here is typed by a merchant, so it can never drift from what the
  checkout charges. With no collection chosen there is nothing honest to
  show, so the section renders nothing at all rather than a placeholder grid.
{% endcomment %}

{%- if section.settings.collection != blank -%}
  <landing-reveal class="home-featured">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      center: true
    %}

    <div
      class="landing-grid"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 2;"
    >
      {%- for product in section.settings.collection.products
        limit: section.settings.products_limit
      -%}
        <a
          href="{{ product.url }}"
          class="home-featured__card reveal"
          aria-label="{{ 'landing.view_product' | t }}: {{ product.title | escape }}"
        >
          <div
            class="media-frame home-featured__media{% if section.settings.image_ratio != 'natural' %} media-frame--{{ section.settings.image_ratio }}{% endif %}"
          >
            {%- if product.featured_image -%}
              {% render 'responsive-image',
                image: product.featured_image,
                section_index: section.index,
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                width: 700
              %}
            {%- endif -%}
          </div>

          <div class="home-featured__body">
            <p class="home-featured__title">{{ product.title }}</p>
            {% render 'price', product: product %}

            {%- if section.settings.show_stock_status -%}
              {%- if product.available -%}
                <span class="pill pill--soft">{{ 'landing.in_stock' | t }}</span>
              {%- else -%}
                <span class="pill">{{ 'landing.sold_out' | t }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="home-featured__footer">
        {% render 'button',
          label: section.settings.cta_label,
          url: section.settings.cta_url,
          style: 'secondary',
          size: 'large'
        %}
      </div>
    {%- endif -%}
  </landing-reveal>
{%- endif -%}

{% stylesheet %}
  .home-featured__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-cards);
    overflow: hidden;
    background-color: var(--color-background);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-featured__card {
      transition:
        box-shadow var(--transition-fast),
        transform var(--transition-fast);
    }

    .home-featured__card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
  }

  .home-featured__media {
    border-radius: 0;
  }

  .home-featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
    padding: var(--space-md);
  }

  .home-featured__title {
    font-weight: 700;
  }

  .home-featured__footer {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_featured",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Productos destacados"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.home_featured"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:labels.products_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "natural", "label": "t:options.image_ratio.natural" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_stock_status",
      "label": "t:labels.show_stock_status",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Ver toda la tienda"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.cta_url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_featured"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
