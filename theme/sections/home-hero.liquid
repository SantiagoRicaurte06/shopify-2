{% comment %}
  The top of the home page.

  This is the one place in the whole theme where an <h1> is the store name or
  tagline rather than a product name — the home page has no product of its
  own, so the heading setting is the real headline instead of a fallback.

  Two layouts share one markup so the blocks slot is never rendered twice:
  "split" keeps the image in its own column, "full" turns the same image into
  a full-bleed background with a scrim behind the content. Only the class on
  the outer element and a couple of CSS rules change between them.
{% endcomment %}

{%- liquid
  assign is_full = false
  assign hero_sizes = '(min-width: 750px) 50vw, 100vw'
  if section.settings.layout == 'full'
    assign is_full = true
    assign hero_sizes = '100vw'
  endif

  assign overlay = section.settings.overlay_opacity | default: 35 | divided_by: 100.0
-%}

<div
  class="home-hero home-hero--{{ section.settings.layout }}{% if is_full %} full-width{% endif %}"
>
  <div class="home-hero__media">
    {% render 'responsive-image',
      image: section.settings.image,
      image_mobile: section.settings.image_mobile,
      section_index: section.index,
      lcp: true,
      sizes: hero_sizes,
      class: 'home-hero__image'
    %}

    {%- if is_full -%}
      <div class="home-hero__overlay" style="--home-hero-overlay: {{ overlay }};"></div>
    {%- endif -%}
  </div>

  <landing-reveal class="home-hero__content home-hero__content--{{ section.settings.align }}">
    <div class="home-hero__copy reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="home-hero__subheading prose">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank
        or section.settings.secondary_cta_label != blank
      -%}
        <div class="home-hero__actions">
          {%- if section.settings.cta_label != blank -%}
            {% render 'button',
              label: section.settings.cta_label,
              url: section.settings.cta_url,
              size: 'large'
            %}
          {%- endif -%}

          {%- if section.settings.secondary_cta_label != blank -%}
            {% render 'button',
              label: section.settings.secondary_cta_label,
              url: section.settings.secondary_cta_url,
              style: 'secondary',
              size: 'large'
            %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="home-hero__trust">
          {% content_for 'blocks' %}
        </ul>
      {%- endif -%}
    </div>
  </landing-reveal>
</div>

{% stylesheet %}
  /* The home hero starts right under the header, with no leading gap. */
  .shopify-section:has(> .home-hero) {
    padding-block-start: 0;
  }

  .home-hero {
    position: relative;
    display: grid;
    gap: var(--space-xl);
  }

  .home-hero__media {
    position: relative;
  }

  .home-hero__image {
    width: 100%;
    border-radius: var(--style-border-radius-cards);
  }

  .home-hero__content {
    display: flex;
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 34rem;
  }

  .home-hero__content--center .home-hero__copy {
    align-items: center;
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .home-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__content--center .home-hero__trust {
    justify-content: center;
  }

  /* Split layout: image and copy side by side from tablet up. */
  @media screen and (min-width: 750px) {
    .home-hero--split {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    .home-hero--split .home-hero__image {
      aspect-ratio: 4 / 5;
      object-fit: cover;
      height: 100%;
    }
  }

  /*
   * Full-bleed layout: the image and its scrim fill the section, the copy
   * sits on top. `full-width` (a shared theme utility) already stretches this
   * element to the viewport, so only the internal stacking is section-owned.
   */
  .home-hero--full {
    display: flex;
    align-items: center;
    min-height: 32rem;
    padding-inline: var(--page-margin);
  }

  .home-hero--full .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero--full .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .home-hero--full .home-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-dark);
    opacity: var(--home-hero-overlay, 0.35);
  }

  .home-hero--full .home-hero__content {
    position: relative;
    width: 100%;
    color: var(--color-dark-foreground);
  }

  .home-hero--full .home-hero__subheading {
    color: var(--color-dark-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_hero",
  "tag": "section",
  "blocks": [{ "type": "trust-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Productos pensados para tu día a día"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "header",
      "content": "t:general.buy_form"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Ver productos"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.cta_url"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "t:labels.secondary_cta_label"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "t:labels.secondary_cta_url"
    },
    {
      "type": "header",
      "content": "t:general.gallery"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "t:options.layout.split" },
        { "value": "full", "label": "t:options.layout.full" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "info": "t:info.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "visible_if": "{{ section.settings.layout == 'full' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:labels.align",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_hero",
      "blocks": [
        { "type": "trust-item", "settings": { "icon": "truck", "text": "Envíos a toda Colombia" } },
        { "type": "trust-item", "settings": { "icon": "lock", "text": "Pago seguro" } },
        { "type": "trust-item", "settings": { "icon": "chat", "text": "Atención por WhatsApp" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
