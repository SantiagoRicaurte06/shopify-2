{% comment %}
  Shipping expectations: a table of destinations and delivery times, plus the
  shop-wide policy from the theme settings.

  Delivery times are a promise. Only state what the carrier actually meets.
{% endcomment %}

<landing-reveal class="landing-shipping{% if section.settings.background != 'none' %} bg-{{ section.settings.background }}{% endif %}">
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading,
    center: true
  %}

  <div class="landing-shipping__panel">
    {%- if section.blocks.size > 0 -%}
      <div class="landing-shipping__table card">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}

    {%- if settings.shipping_policy != blank -%}
      <div class="landing-shipping__policy prose">
        <span class="icon-tile icon-tile--round">{% render 'icon', name: 'truck' %}</span>
        <div class="muted">{{ settings.shipping_policy }}</div>
      </div>
    {%- endif -%}
  </div>
</landing-reveal>

{% stylesheet %}
  .landing-shipping__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 44rem;
    margin-inline: auto;
  }

  /* The rows sit in a single card with hairlines between them, so the table
     reads as one object instead of as a stack of boxes. */
  .landing-shipping__table {
    padding-block: var(--space-2xs);
  }

  .landing-shipping__table > :last-child {
    border-block-end: 0;
  }

  /* The shop-wide policy is a note, not another row: it is the sentence a
     reader checks before paying, so it gets its own quiet panel. */
  .landing-shipping__policy {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--style-border-radius-cards);
    background-color: var(--color-surface);
    font-size: var(--font-size-sm);
  }

  .shopify-section:has(> .bg-soft) .landing-shipping__policy {
    background-color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.shipping",
  "tag": "section",
  "blocks": [{ "type": "shipping-row" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Envíos"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "info": "t:info.section_background",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background.none" },
        { "value": "soft", "label": "t:options.background.soft" },
        { "value": "dark", "label": "t:options.background.dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shipping",
      "blocks": [{ "type": "shipping-row" }, { "type": "shipping-row" }]
    }
  ]
}
{% endschema %}
