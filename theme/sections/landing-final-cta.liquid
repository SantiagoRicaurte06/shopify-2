{% comment %}
  The last ask, for the reader who scrolled the whole page.

  It links up to the offer section rather than repeating the buy form, so the
  page keeps exactly one place where the purchase is configured and there is
  no second form to keep in sync.
{% endcomment %}

<div class="landing-final-cta full-width">
  <landing-reveal class="landing-final-cta__inner">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      center: true
    %}

    {% render 'button', label: section.settings.cta_label, url: '#landing-offer', size: 'large' %}

    {%- if section.blocks.size > 0 -%}
      <ul class="landing-final-cta__trust">
        {% content_for 'blocks' %}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_whatsapp -%}
      {% render 'whatsapp-link', product: product, style: 'text' %}
    {%- endif -%}
  </landing-reveal>
</div>

{% stylesheet %}
  .landing-final-cta {
    background-color: var(--color-surface);
    padding-block: var(--space-2xl);
  }

  .landing-final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-inline: var(--page-margin);
    text-align: center;
  }

  .landing-final-cta__inner .section-header {
    margin-block-end: 0;
  }

  .landing-final-cta__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.final_cta",
  "tag": "section",
  "blocks": [{ "type": "trust-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Pídelo hoy"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Elegir mi paquete"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "t:labels.show_whatsapp",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.final_cta",
      "blocks": [
        { "type": "trust-item", "settings": { "icon": "truck", "text": "Envíos a toda Colombia" } },
        { "type": "trust-item", "settings": { "icon": "lock", "text": "Pago seguro" } }
      ]
    }
  ]
}
{% endschema %}
