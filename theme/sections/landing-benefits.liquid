{% comment %}
  The benefits grid.

  Column counts are settings rather than fixed, because three benefits and
  five benefits want different layouts and the merchant should not need a
  developer to change their mind.
{% endcomment %}

<landing-reveal class="landing-benefits{% if section.settings.background != 'none' %} bg-{{ section.settings.background }}{% endif %}">
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading,
    center: section.settings.center
  %}

  <div
    class="landing-grid"
    style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
  >
    {% content_for 'blocks' %}
  </div>
</landing-reveal>

{% schema %}
{
  "name": "t:sections.benefits",
  "tag": "section",
  "blocks": [{ "type": "benefit-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Por qué funciona"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "t:labels.center_header",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "info": "t:info.section_background",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background.none" },
        { "value": "soft", "label": "t:options.background.soft" },
        { "value": "dark", "label": "t:options.background.dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.benefits",
      "blocks": [
        { "type": "benefit-item" },
        { "type": "benefit-item", "settings": { "icon": "clock" } },
        { "type": "benefit-item", "settings": { "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
