{% comment %}
  The top of the landing: gallery, name, rating, price and the first buy button.

  Four things are load-bearing here.

  The <h1> is the product name. There is exactly one on the page, and the
  heading setting only replaces its text — it can never turn into an <h2> or
  add a second <h1>.

  The first image is the LCP candidate on almost every visit, so it is passed
  through the responsive-image snippet with `lcp: true`, which forces eager
  loading and a high fetch priority. Nothing above the fold is lazy. The
  thumbnails are, because they are small and below the important pixel.

  The gallery is a scroll-snap track in both layouts. It swipes natively on a
  phone and works with the script switched off; the thumbnails and the arrows
  are progressive enhancement layered on top by landing.js. The stage keeps a
  fixed aspect ratio so the page does not jump while images arrive.

  The buy button carries an id so the sticky mobile bar can watch it and stay
  out of the way while the real button is on screen.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: product.title
  assign gallery_limit = section.settings.gallery_limit | default: 5
  assign layout = section.settings.gallery_layout | default: 'thumbnails'

  # Cap the count rather than slicing the drop, so the two loops below and
  # this number can never disagree about how many slides exist.
  assign media_count = product.media.size
  if media_count > gallery_limit
    assign media_count = gallery_limit
  endif

  assign frame_class = 'media-frame'
  case section.settings.image_ratio
    when 'portrait'
      assign frame_class = 'media-frame media-frame--portrait'
    when 'natural'
      assign frame_class = 'media-frame media-frame--natural'
    else
      assign frame_class = 'media-frame media-frame--square'
  endcase
-%}

<div class="landing-hero">
  <div class="landing-hero__media">
    {%- if media_count > 0 -%}
      <landing-carousel class="hero-gallery hero-gallery--{{ layout }}">
        <div class="hero-gallery__stage landing-scroller" data-carousel-track>
          {%- for media in product.media limit: gallery_limit -%}
            <div class="hero-gallery__slide {{ frame_class }}" id="HeroSlide-{{ forloop.index }}">
              {% render 'media',
                media: media,
                section_index: section.index,
                lcp: forloop.first,
                sizes: '(min-width: 990px) 45vw, (min-width: 750px) 50vw, 100vw'
              %}
            </div>
          {%- endfor -%}
        </div>

        {%- if media_count > 1 -%}
          {%- if layout == 'thumbnails' -%}
            <ul class="hero-gallery__thumbs" aria-label="{{ 'landing.gallery' | t }}">
              {%- for media in product.media limit: gallery_limit -%}
                <li>
                  <button
                    class="hero-gallery__thumb"
                    type="button"
                    data-carousel-thumb
                    data-index="{{ forloop.index0 }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                  >
                    <span class="visually-hidden">
                      {{- 'landing.view_image' | t: index: forloop.index -}}
                    </span>
                    {% render 'responsive-image',
                      image: media.preview_image,
                      sizes: '72px',
                      width: 160,
                      height: 160,
                      crop: 'center'
                    %}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="carousel-controls">
              <button
                class="carousel-control"
                type="button"
                data-carousel-previous
                aria-label="{{ 'landing.previous' | t }}"
              >
                {% render 'icon', name: 'chevron-left' %}
              </button>
              <button
                class="carousel-control"
                type="button"
                data-carousel-next
                aria-label="{{ 'landing.next' | t }}"
              >
                {% render 'icon', name: 'chevron-right' %}
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}
      </landing-carousel>
    {%- else -%}
      <div class="{{ frame_class }}">
        {{ 'product-1' | placeholder_svg_tag: 'landing-hero__placeholder' }}
      </div>
    {%- endif -%}
  </div>

  <div class="landing-hero__info">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="landing-hero__title">{{ heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <div class="landing-hero__subheading prose">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.settings.show_rating -%}
      {% render 'stars', product: product, show_count: true %}
    {%- endif -%}

    <div class="landing-hero__pricing">
      {%- if section.settings.show_price -%}
        {% render 'price', product: product, show_saving: true %}
      {%- endif -%}

      {%- if settings.shipping_claim != blank -%}
        <span class="pill pill--soft">{{ settings.shipping_claim }}</span>
      {%- endif -%}
    </div>

    {% render 'product-form',
      product: product,
      form_id: 'hero-form',
      show_variant_picker: section.settings.show_variant_picker,
      show_quantity: section.settings.show_quantity,
      show_payment_button: section.settings.show_payment_button,
      button_label: section.settings.cta_label,
      button_id: 'hero-buy-button'
    %}

    {%- if settings.shipping_policy != blank -%}
      <div class="landing-hero__shipping muted">{{ settings.shipping_policy }}</div>
    {%- endif -%}

    {% render 'payment-icons' %}

    {%- if section.blocks.size > 0 -%}
      <ul class="landing-hero__trust">
        {% content_for 'blocks' %}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_whatsapp -%}
      {% render 'whatsapp-link', product: product, style: 'text' %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .landing-hero {
    display: grid;
    gap: var(--space-xl);
    padding-block-start: var(--space-lg);
  }

  @media screen and (min-width: 750px) {
    .landing-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: start;
      padding-block-start: var(--space-xl);
    }
  }

  /* Gallery ------------------------------------------------------------ */

  .hero-gallery {
    display: grid;
    gap: var(--space-sm);
  }

  .hero-gallery__stage {
    /* The scroller's own grid supplies the track; one slide fills the frame. */
    grid-auto-columns: 100%;
    gap: var(--space-xs);
  }

  .hero-gallery__slide {
    scroll-snap-align: center;
  }

  .media-frame--natural {
    aspect-ratio: auto;
  }

  .media-frame--natural > img,
  .media-frame--natural > video {
    height: auto;
    object-fit: contain;
  }

  .landing-hero__placeholder {
    width: 100%;
    height: auto;
  }

  .hero-gallery__thumbs {
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hero-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .hero-gallery__thumb {
    display: block;
    padding: 0;
    width: 4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-surface);
    overflow: hidden;
    cursor: pointer;
  }

  .hero-gallery__thumb img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .hero-gallery__thumb[aria-current='true'] {
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-gallery__thumb {
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }
  }

  /* On a wide screen the thumbnails become a rail beside the stage, which is
     what a product page is expected to look like and saves vertical space. */
  @media screen and (min-width: 990px) {
    .hero-gallery--thumbnails {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      align-items: start;
    }

    .hero-gallery--thumbnails .hero-gallery__stage {
      grid-column: 2;
      grid-row: 1;
    }

    .hero-gallery--thumbnails .hero-gallery__thumbs {
      grid-column: 1;
      grid-row: 1;
      flex-direction: column;
      overflow-x: visible;
      overflow-y: auto;
      max-height: 100%;
    }

    .hero-gallery--thumbnails .hero-gallery__thumb {
      width: 100%;
    }
  }

  /* Buy column --------------------------------------------------------- */

  .landing-hero__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media screen and (min-width: 750px) {
    .landing-hero__info {
      position: sticky;
      inset-block-start: var(--space-xl);
    }
  }

  .landing-hero__title {
    margin-block-end: calc(var(--space-2xs) * -1);
  }

  .landing-hero__subheading {
    color: var(--color-muted);
    font-size: var(--font-size-lg);
    max-width: 46ch;
  }

  .landing-hero__pricing {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-block: var(--space-2xs);
  }

  .landing-hero__shipping {
    font-size: var(--font-size-sm);
  }

  /* The trust row reads as a row of small badges rather than a bullet list,
     which is what separates a brand page from a template. */
  .landing-hero__trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    margin-block-start: var(--space-2xs);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    list-style: none;
  }

  .landing-hero__trust .trust-item {
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    text-align: center;
    font-size: var(--font-size-xs);
    line-height: 1.35;
  }

  @media screen and (min-width: 480px) {
    .landing-hero__trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero",
  "tag": "section",
  "blocks": [{ "type": "trust-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.hero_heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.show_rating",
      "info": "t:info.reviews_aggregate",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.buy_form"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label"
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "t:labels.show_variant_picker",
      "info": "t:info.show_variant_picker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:labels.show_quantity",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_button",
      "label": "t:labels.show_payment_button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "t:labels.show_whatsapp",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:labels.gallery_layout",
      "info": "t:info.gallery_layout",
      "default": "thumbnails",
      "options": [
        { "value": "thumbnails", "label": "t:options.gallery_layout.thumbnails" },
        { "value": "carousel", "label": "t:options.gallery_layout.carousel" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "natural", "label": "t:options.image_ratio.natural" }
      ]
    },
    {
      "type": "range",
      "id": "gallery_limit",
      "label": "t:labels.gallery_limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero",
      "blocks": [
        { "type": "trust-item" },
        { "type": "trust-item", "settings": { "icon": "lock", "text": "Compra segura" } },
        { "type": "trust-item", "settings": { "icon": "shield", "text": "Garantía" } },
        { "type": "trust-item", "settings": { "icon": "chat", "text": "Soporte por WhatsApp" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
