{% comment %}
  Reviews, in three layers that can be used together or separately.

  1. The aggregate — average rating and review count — comes only from the
     standard `reviews.rating` and `reviews.rating_count` metafields, which a
     reviews app writes. If the product has neither, no stars appear. The
     theme never computes an average from its own content, because content the
     merchant typed is not a measurement.

  2. Individual reviews come either from `landing_review` metaobject entries
     (a library reusable across products) or from review-item blocks typed in
     this section.

  3. An app slot, so Judge.me, Loox or anything else drops in without a code
     change.

  Anything the merchant marks as a demo renders a visible "fictional content"
  label and is excluded from the page's structured data.

  Note on the metaobject source: `landing_review` is a custom definition, so it
  must exist in the shop before the picker will work. See
  docs/metaobjects.md. The section works with blocks alone until then.
{% endcomment %}

{%- liquid
  assign entries = section.settings.reviews.value | default: section.settings.reviews
-%}

<landing-reveal
  class="landing-reviews{% if section.settings.background != 'none' %} bg-{{ section.settings.background }}{% endif %}"
  id="landing-reviews"
>
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading,
    center: true
  %}

  {%- if section.settings.show_aggregate -%}
    {%- liquid
      # The average and the count are a measurement. They come only from the
      # standard metafields a reviews app writes, never from the cards below,
      # so the panel simply does not appear until real data exists.
      assign aggregate = product.metafields.reviews.rating.value
      assign review_count = product.metafields.reviews.rating_count.value | plus: 0
    -%}

    {%- if aggregate != blank and aggregate.rating != blank and review_count > 0 -%}
      <div class="landing-reviews__summary">
        <p class="landing-reviews__score">
          {{- aggregate.rating -}}
          <span class="landing-reviews__scale muted">/ {{ aggregate.scale_max | default: 5 }}</span>
        </p>

        <div class="landing-reviews__summary-meta">
          {% render 'stars', product: product %}
          <p class="muted text-sm">
            {{- 'landing.based_on_reviews' | t: count: review_count -}}
          </p>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.source == 'metaobject' and entries.size > 0 -%}
    <div
      class="landing-grid landing-reviews__list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 1;"
    >
      {%- for entry in entries limit: section.settings.limit -%}
        {% render 'review-card',
          body: entry.body.value,
          rating: entry.rating.value,
          author: entry.author.value,
          location: entry.location.value,
          image: entry.image.value,
          is_demo: entry.is_demo.value
        %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div
      class="landing-grid landing-reviews__list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 1;"
    >
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</landing-reveal>

{% stylesheet %}
  .landing-reviews__summary {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    max-width: 26rem;
    margin: 0 auto var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-cards);
    background-color: var(--color-background);
  }

  .landing-reviews__score {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .landing-reviews__scale {
    margin-inline-start: var(--space-3xs);
    font-size: var(--font-size-base);
    font-weight: 400;
  }

  .landing-reviews__summary-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  /* On a phone three review cards stacked is a long scroll past the offer.
     They become a swipeable rail instead, which is how people read them. */
  @media screen and (max-width: 749px) {
    .landing-reviews__list {
      display: grid;
      grid-auto-columns: minmax(min(19rem, 82%), 1fr);
      grid-auto-flow: column;
      grid-template-columns: none;
      gap: var(--space-md);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      padding-block-end: var(--space-2xs);
    }

    .landing-reviews__list::-webkit-scrollbar {
      display: none;
    }

    .landing-reviews__list > * {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.reviews",
  "tag": "section",
  "blocks": [{ "type": "review-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Lo que dicen quienes ya lo compraron"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "checkbox",
      "id": "show_aggregate",
      "label": "t:labels.show_rating",
      "info": "t:info.reviews_aggregate",
      "default": true
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:labels.reviews_source",
      "default": "blocks",
      "options": [
        { "value": "blocks", "label": "t:options.reviews_source.blocks" },
        { "value": "metaobject", "label": "t:options.reviews_source.metaobject" }
      ]
    },
    {
      "type": "metaobject_list",
      "id": "reviews",
      "label": "t:labels.reviews_entries",
      "info": "t:info.reviews_metaobject",
      "metaobject_type": "landing_review",
      "limit": 24
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.reviews_limit",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.source == 'metaobject' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "info": "t:info.section_background",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background.none" },
        { "value": "soft", "label": "t:options.background.soft" },
        { "value": "dark", "label": "t:options.background.dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews",
      "blocks": [{ "type": "review-item" }, { "type": "review-item" }, { "type": "review-item" }]
    }
  ]
}
{% endschema %}
