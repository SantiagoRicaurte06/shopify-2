{% comment %}
  Reviews, in three layers that can be used together or separately.

  1. The aggregate — average rating and review count — comes only from the
     standard `reviews.rating` and `reviews.rating_count` metafields, which a
     reviews app writes. If the product has neither, no stars appear. The
     theme never computes an average from its own content, because content the
     merchant typed is not a measurement.

  2. Individual reviews come either from `landing_review` metaobject entries
     (a library reusable across products) or from review-item blocks typed in
     this section.

  3. An app slot, so Judge.me, Loox or anything else drops in without a code
     change.

  Anything the merchant marks as a demo renders a visible "fictional content"
  label and is excluded from the page's structured data.

  Note on the metaobject source: `landing_review` is a custom definition, so it
  must exist in the shop before the picker will work. See
  docs/metaobjects.md. The section works with blocks alone until then.
{% endcomment %}

{%- liquid
  assign entries = section.settings.reviews.value | default: section.settings.reviews
-%}

<landing-reveal class="landing-reviews" id="landing-reviews">
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading,
    center: true
  %}

  {%- if section.settings.show_aggregate -%}
    <div class="landing-reviews__aggregate">
      {% render 'stars', product: product, show_count: true %}
    </div>
  {%- endif -%}

  {%- if section.settings.source == 'metaobject' and entries.size > 0 -%}
    <div
      class="landing-grid"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 1;"
    >
      {%- for entry in entries limit: section.settings.limit -%}
        {% render 'review-card',
          body: entry.body.value,
          rating: entry.rating.value,
          author: entry.author.value,
          location: entry.location.value,
          image: entry.image.value,
          is_demo: entry.is_demo.value
        %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div
      class="landing-grid"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 1;"
    >
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</landing-reveal>

{% stylesheet %}
  .landing-reviews__aggregate {
    display: flex;
    justify-content: center;
    margin-block-end: var(--space-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.reviews",
  "tag": "section",
  "blocks": [{ "type": "review-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Lo que dicen quienes ya lo compraron"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "checkbox",
      "id": "show_aggregate",
      "label": "t:labels.show_rating",
      "info": "t:info.reviews_aggregate",
      "default": true
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:labels.reviews_source",
      "default": "blocks",
      "options": [
        { "value": "blocks", "label": "t:options.reviews_source.blocks" },
        { "value": "metaobject", "label": "t:options.reviews_source.metaobject" }
      ]
    },
    {
      "type": "metaobject_list",
      "id": "reviews",
      "label": "t:labels.reviews_entries",
      "info": "t:info.reviews_metaobject",
      "metaobject_type": "landing_review",
      "limit": 24
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.reviews_limit",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.source == 'metaobject' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews",
      "blocks": [{ "type": "review-item" }, { "type": "review-item" }, { "type": "review-item" }]
    }
  ]
}
{% endschema %}
