{% comment %}
  The plain product page, used by templates/product.json.

  This is the fallback for products that do not have a landing. It is
  deliberately ordinary: gallery, title, price, buy form, description. The
  selling work happens in the landing template.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product">
  <div class="product__media">
    {%- for media in product.media -%}
      {% render 'media',
        media: media,
        section_index: section.index,
        lcp: forloop.first,
        sizes: '(min-width: 750px) 50vw, 100vw'
      %}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
    {%- endfor -%}
  </div>

  <div class="product__info">
    <h1>{{ product.title }}</h1>

    {% render 'stars', product: product, show_count: true %}
    {% render 'price', product: product, show_saving: true %}

    {% render 'product-form',
      product: product,
      form_id: 'product-form',
      show_variant_picker: true,
      show_quantity: true,
      show_payment_button: true
    %}

    {% render 'payment-icons' %}

    <div class="product__description rte">{{ product.description }}</div>
  </div>
</div>

{% stylesheet %}
  .product {
    display: grid;
    gap: var(--space-xl);
  }

  @media screen and (min-width: 750px) {
    .product {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .product__media {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .product__media img,
  .product__media video {
    width: 100%;
    border-radius: var(--style-border-radius-cards);
  }

  .product__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .product__description > * + * {
    margin-block-start: var(--space-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
