{% comment %}
  Shopify's built-in contact form. A submission lands in the store's Contact
  notification inbox exactly like the platform's own contact template — there
  is no custom backend to run or third-party form service to keep in sync.

  The store details beside the form are read straight from the theme's brand
  and contact settings, and each one only prints when the merchant has
  actually filled it in. A field left blank simply does not appear; nothing
  here is invented to fill the column.
{% endcomment %}

<landing-reveal class="contact-form">
  {% render 'section-header',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading
  %}

  <div class="contact-form__grid">
    <div class="contact-form__form-wrap reveal">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-form__success" role="status">
            {{ section.settings.success_message }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="contact-form__errors" role="alert">
            <ul>
              {%- for field in form.errors -%}
                <li id="ContactForm-error-{{ field }}">
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="contact-form__field">
          <label for="ContactForm-name">{{ 'contact.name' | t }}</label>
          <input
            type="text"
            name="contact[name]"
            id="ContactForm-name"
            value="{{ form.name }}"
            autocomplete="name"
          >
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-email">
            {{- 'contact.email' | t }}
            <span class="visually-hidden">({{ 'contact.required' | t }})</span>
          </label>
          <input
            type="email"
            name="contact[email]"
            id="ContactForm-email"
            value="{{ form.email }}"
            required
            aria-required="true"
            autocomplete="email"
            {%- if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-error-email"
            {%- endif %}
          >
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
          <input
            type="tel"
            name="contact[phone]"
            id="ContactForm-phone"
            value="{{ form.phone }}"
            autocomplete="tel"
          >
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-body">
            {{- 'contact.message' | t }}
            <span class="visually-hidden">({{ 'contact.required' | t }})</span>
          </label>
          <textarea
            name="contact[body]"
            id="ContactForm-body"
            rows="5"
            required
            aria-required="true"
            {%- if form.errors contains 'body' %}
              aria-invalid="true"
              aria-describedby="ContactForm-error-body"
            {%- endif %}
          >{{ form.body }}</textarea>
        </div>

        {%- assign send_label = 'contact.send' | t -%}
        {% render 'button', label: send_label, size: 'large', full_width: true %}
      {%- endform -%}
    </div>

    {%- if section.settings.show_contact -%}
      <div class="contact-form__info reveal">
        {%- if settings.contact_email != blank -%}
          <p class="contact-form__info-row">
            {% render 'icon', name: 'mail' %}
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          </p>
        {%- endif -%}

        {%- if settings.contact_phone != blank -%}
          <p class="contact-form__info-row">
            {% render 'icon', name: 'phone' %}
            <a href="tel:{{ settings.contact_phone | remove: ' ' }}">
              {{- settings.contact_phone -}}
            </a>
          </p>
        {%- endif -%}

        {%- if settings.contact_address != blank -%}
          <p class="contact-form__info-row">
            {% render 'icon', name: 'pin' %}
            {{ settings.contact_address }}
          </p>
        {%- endif -%}

        {%- if settings.contact_hours != blank -%}
          <p class="contact-form__info-row muted">
            {% render 'icon', name: 'clock' %}
            {{ settings.contact_hours }}
          </p>
        {%- endif -%}

        {% render 'whatsapp-link' %}
      </div>
    {%- endif -%}
  </div>
</landing-reveal>

{% stylesheet %}
  .contact-form__info-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .contact-form__info-row .icon {
    margin-block-start: 0.15em;
    color: var(--color-muted);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  @media screen and (min-width: 750px) {
    .contact-form__grid {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
    }
  }

  .contact-form__success {
    margin-block-end: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 700;
  }

  .contact-form__errors {
    margin-block-end: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-sale);
    border-radius: var(--style-border-radius-inputs);
  }

  .contact-form__errors ul {
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-end: var(--space-md);
  }

  .contact-form__field label {
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    min-height: var(--tap-target);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .contact-form__field textarea {
    min-height: 8rem;
    resize: vertical;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-form__field input,
    .contact-form__field textarea {
      transition: border-color var(--transition-fast);
    }
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    border-color: var(--color-accent);
  }

  .contact-form__field input[aria-invalid='true'],
  .contact-form__field textarea[aria-invalid='true'] {
    border-color: var(--color-sale);
  }

  .contact-form__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border-radius: var(--style-border-radius-cards);
    background-color: var(--color-surface);
  }

  .contact-form__info-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .contact-form__info-row .icon {
    color: var(--color-accent);
    flex: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:contact.title"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "richtext",
      "id": "success_message",
      "label": "t:labels.success_message",
      "info": "t:info.contact_form_success",
      "default": "t:contact.success"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:labels.show_contact",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form"
    }
  ]
}
{% endschema %}
