{% comment %}
  Photos from customers.

  Hides itself when it has no blocks, so a landing published before any real
  customer content exists simply does not show an empty band.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <landing-reveal class="landing-ugc">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      center: true
    %}

    <landing-carousel>
      <div class="landing-scroller" data-carousel-track>
        {% content_for 'blocks' %}
      </div>

      <div class="landing-ugc__controls">
        <button
          class="carousel-control"
          type="button"
          data-carousel-previous
          aria-label="{{ 'landing.previous' | t }}"
        >
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button
          class="carousel-control"
          type="button"
          data-carousel-next
          aria-label="{{ 'landing.next' | t }}"
        >
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    </landing-carousel>
  </landing-reveal>
{%- endif -%}

{% stylesheet %}
  .landing-ugc__controls {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.ugc",
  "tag": "section",
  "blocks": [{ "type": "ugc-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.ugc_rights"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Nuestros clientes"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    }
  ],
  "presets": [
    {
      "name": "t:sections.ugc"
    }
  ]
}
{% endschema %}
