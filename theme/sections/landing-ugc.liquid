{% comment %}
  Photos from customers.

  Hides itself when it has no blocks, so a landing published before any real
  customer content exists simply does not show an empty band.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <landing-reveal class="landing-ugc{% if section.settings.background != 'none' %} bg-{{ section.settings.background }}{% endif %}">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      center: true
    %}

    <landing-carousel>
      <div class="landing-scroller" data-carousel-track>
        {% content_for 'blocks' %}
      </div>

      <div class="carousel-controls">
        <button
          class="carousel-control"
          type="button"
          data-carousel-previous
          aria-label="{{ 'landing.previous' | t }}"
        >
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button
          class="carousel-control"
          type="button"
          data-carousel-next
          aria-label="{{ 'landing.next' | t }}"
        >
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    </landing-carousel>
  </landing-reveal>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.ugc",
  "tag": "section",
  "blocks": [{ "type": "ugc-item" }, { "type": "@app" }],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.ugc_rights"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Nuestros clientes"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "info": "t:info.section_background",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background.none" },
        { "value": "soft", "label": "t:options.background.soft" },
        { "value": "dark", "label": "t:options.background.dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ugc"
    }
  ]
}
{% endschema %}
