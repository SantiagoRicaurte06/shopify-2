[
  {
    "name": "theme_info",
    "theme_name": "Landings Colombia",
    "theme_version": "0.1.0",
    "theme_author": "Santiago Ricaurte",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n7",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "type_scale",
        "min": 1,
        "max": 1.4,
        "step": 0.1,
        "unit": "x",
        "label": "t:labels.type_scale",
        "info": "t:info.type_scale",
        "default": 1.2
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "75rem",
            "label": "t:options.page_width.landing"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "75rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.section_spacing",
        "info": "t:info.section_spacing",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#152234",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#5B6675",
        "label": "t:labels.muted",
        "info": "t:info.muted"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F6F7F9",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E3E7EC",
        "label": "t:labels.border"
      },
      {
        "type": "header",
        "content": "t:general.accent"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#1F3D5C",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "cta_background_color",
        "default": "#16283F",
        "label": "t:labels.cta_background"
      },
      {
        "type": "color",
        "id": "cta_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.cta_foreground"
      },
      {
        "type": "color",
        "id": "sale_color",
        "default": "#B42318",
        "label": "t:labels.sale",
        "info": "t:info.sale"
      },
      {
        "type": "color",
        "id": "star_color",
        "default": "#E0A526",
        "label": "t:labels.star",
        "info": "t:info.star"
      },
      {
        "type": "header",
        "content": "t:general.dark_panel"
      },
      {
        "type": "color",
        "id": "dark_background_color",
        "default": "#12233A",
        "label": "t:labels.dark_background",
        "info": "t:info.dark_panel"
      },
      {
        "type": "color",
        "id": "dark_foreground_color",
        "default": "#FFFFFF",
        "label": "t:labels.dark_foreground"
      },
      {
        "type": "header",
        "content": "t:general.shapes"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 10
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 14
      }
    ]
  },
  {
    "name": "t:general.conversion",
    "settings": [
      {
        "type": "header",
        "content": "t:general.whatsapp"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:labels.whatsapp_number",
        "info": "t:info.whatsapp_number"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "t:labels.whatsapp_message",
        "info": "t:info.whatsapp_message",
        "default": "Hola, quiero más información sobre este producto."
      },
      {
        "type": "header",
        "content": "t:general.shipping"
      },
      {
        "type": "text",
        "id": "shipping_claim",
        "label": "t:labels.shipping_claim",
        "info": "t:info.shipping_claim",
        "default": "Envíos a toda Colombia"
      },
      {
        "type": "richtext",
        "id": "shipping_policy",
        "label": "t:labels.shipping_policy",
        "info": "t:info.shipping_policy"
      },
      {
        "type": "richtext",
        "id": "guarantee_policy",
        "label": "t:labels.guarantee_policy",
        "info": "t:info.guarantee_policy"
      }
    ]
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.brand_intro"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "t:labels.brand_tagline",
        "info": "t:info.brand_tagline"
      },
      {
        "type": "textarea",
        "id": "brand_description",
        "label": "t:labels.brand_description",
        "info": "t:info.brand_description"
      },
      {
        "type": "header",
        "content": "t:general.contact"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "t:labels.contact_email"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "t:labels.contact_phone",
        "info": "t:info.contact_phone"
      },
      {
        "type": "text",
        "id": "contact_address",
        "label": "t:labels.contact_address",
        "info": "t:info.contact_address"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "t:labels.contact_hours",
        "info": "t:info.contact_hours"
      },
      {
        "type": "header",
        "content": "t:general.social"
      },
      {
        "type": "paragraph",
        "content": "t:info.social_intro"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "t:general.payments",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.payments_intro"
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "t:labels.show_payment_icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_card",
        "label": "t:labels.payment_card",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_pse",
        "label": "t:labels.payment_pse",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_nequi",
        "label": "t:labels.payment_nequi",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_daviplata",
        "label": "t:labels.payment_daviplata",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "payment_bancolombia",
        "label": "t:labels.payment_bancolombia",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_cash",
        "label": "t:labels.payment_cash",
        "info": "t:info.payment_cash",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "payment_bnpl",
        "label": "t:labels.payment_bnpl",
        "info": "t:info.payment_bnpl",
        "default": false
      }
    ]
  },
  {
    "name": "t:general.seo",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_product_json_ld",
        "label": "t:labels.enable_product_json_ld",
        "info": "t:info.enable_product_json_ld",
        "default": true
      }
    ]
  }
]
